# Copie para .env e ajuste. O .env NÃO é versionado.

# Caminho do modelo servido pela API
MODEL_PATH=models/churn_model.joblib

# Limiar de decisão para classificar churn (definido na Etapa 2)
CHURN_THRESHOLD=0.5

# AWS (deploy) - use perfis do AWS CLI, nunca chaves no repositório
AWS_REGION=us-east-1
AWS_PROFILE=default
ECR_REPOSITORY=churn-api
